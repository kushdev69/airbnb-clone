<%layout("/layouts/boilerplatecode")%>

<body>
<div class="auth-page">
	<div class="auth-card">
		<p class="auth-kicker">Welcome back</p>
		<h1>Login</h1>
		<form class="auth-form needs-validation" action="/users/login" method="post" novalidate>
             <div>
			<input class="auth-input form-control" type="text" name="username" placeholder="Username" required>
              <div class="invalid-feedback" class="form-text">Enter your username</div>
            </div>
            <div>
			<input class="auth-input form-control" type="password" name="password" placeholder="Password" required>
              <div class="invalid-feedback" class="form-text">Enter your password</div>
            </div>
			<button class="auth-btn " type="submit">Log in</button>
		</form>
		<p class="auth-foot">New here? <a href="/users/signup">Create an account</a></p>
	</div>
</div>

</body>
